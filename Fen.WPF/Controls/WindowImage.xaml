<Window x:Class="Fen.Wpf.Controls.WindowImage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fen.Wpf.Controls"
        mc:Ignorable="d"
        Title="WindowImage" Height="512" Width="891">
    <Grid>
        <WrapPanel>
            <!--类 Image 使你能够加载以下图像类型：.bmp、.gif、.ico、.jpg、.png、.wdp 和 .tiff。-->
            <Border BorderBrush="Blue" BorderThickness="2">
                <Image Width="200" Source="/images/01.gif"/>
            </Border>
            <Border BorderBrush="Blue" BorderThickness="2">
                <Image Width="200" Source="../images/02.gif" />
            </Border>
            <Border BorderBrush="Blue" BorderThickness="2">
                <Image Width="200" Source="pack://application:,,,/images/03.gif" />
            </Border>
            <Border BorderBrush="Blue" BorderThickness="2">
                <Image Width="200" Source="pack://siteoforigin:,,,/images/04.gif" />
            </Border>
            <Border BorderBrush="Blue" BorderThickness="2">
                <Image Width="200" Source="..\images/05.gif" />
            </Border>
        </WrapPanel>

    </Grid>
</Window>
