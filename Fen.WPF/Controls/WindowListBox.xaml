<Window x:Class="Fen.Wpf.Controls.WindowListBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fen.Wpf.Controls"
        mc:Ignorable="d"
        Title="WindowListBox" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <StackPanel>
            <TextBox Name="tb" Width="800" Height="30" VerticalAlignment="Top"></TextBox>
            <TabControl>
                <TabItem Header="ListBox SelectionMode=Single">
                    <ListBox Name="lb1" Width="100" Height="200" SelectionChanged="PrintText" SelectionMode="Single">
                        <ListBoxItem>Item 1</ListBoxItem>
                        <ListBoxItem>Item 2</ListBoxItem>
                        <ListBoxItem>Item 3</ListBoxItem>
                        <ListBoxItem>Item 4</ListBoxItem>
                        <ListBoxItem>Item 5</ListBoxItem>
                        <ListBoxItem>Item 6</ListBoxItem>
                        <ListBoxItem>Item 7</ListBoxItem>
                        <ListBoxItem>Item 8</ListBoxItem>
                        <ListBoxItem>Item 9</ListBoxItem>
                        <ListBoxItem>Item 10</ListBoxItem>
                    </ListBox>
                </TabItem>
                <TabItem Header="ListBox SelectionMode=Multiple">
                    <ListBox Name="lb2" Width="100" Height="200" SelectionChanged="PrintText" SelectionMode="Multiple">
                        <ListBoxItem>Item 1</ListBoxItem>
                        <ListBoxItem>Item 2</ListBoxItem>
                        <ListBoxItem>Item 3</ListBoxItem>
                        <ListBoxItem>Item 4</ListBoxItem>
                        <ListBoxItem>Item 5</ListBoxItem>
                        <ListBoxItem>Item 6</ListBoxItem>
                        <ListBoxItem>Item 7</ListBoxItem>
                        <ListBoxItem>Item 8</ListBoxItem>
                        <ListBoxItem>Item 9</ListBoxItem>
                        <ListBoxItem>Item 10</ListBoxItem>
                    </ListBox>
                </TabItem>
                <TabItem Header="ListBox SelectionMode=Extended">
                    <ListBox Name="lb3" Width="100" Height="200" SelectionChanged="PrintText" SelectionMode="Extended">
                        <ListBoxItem>Item 1</ListBoxItem>
                        <ListBoxItem>Item 2</ListBoxItem>
                        <ListBoxItem>Item 3</ListBoxItem>
                        <ListBoxItem>Item 4</ListBoxItem>
                        <ListBoxItem>Item 5</ListBoxItem>
                        <ListBoxItem>Item 6</ListBoxItem>
                        <ListBoxItem>Item 7</ListBoxItem>
                        <ListBoxItem>Item 8</ListBoxItem>
                        <ListBoxItem>Item 9</ListBoxItem>
                        <ListBoxItem>Item 10</ListBoxItem>
                    </ListBox>
                </TabItem>
                <TabItem Header="动态加载">
                    <ListBox Name="listbox" Width="100" Height="200" SelectionChanged="PrintText1" SelectionMode="Extended" ItemsSource="{Binding}">
                        <ListBox.ItemTemplate>
                            <ItemContainerTemplate>
                                <TextBlock Text="{Binding}"></TextBlock>
                            </ItemContainerTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>


        </StackPanel>
    </Grid>
</Window>
