<Window x:Class="Fen.Wpf.Controls.WindowImageBrush"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fen.Wpf.Controls"
        mc:Ignorable="d"
        Title="WindowImageBrush" Height="450" Width="800">
    <Grid>
        <StackPanel>
        <!--使用图像绘制区域。-->
        <TextBlock Background="Orange" Width="200" Height="80" FontSize="60pt" FontFamily="新宋" TextAlignment="Center" Text="Next">
            <TextBlock.Foreground>
                <ImageBrush ImageSource="/images/03.gif" TileMode="FlipX" ViewportUnits="Absolute" Viewport="0,0,5,5"></ImageBrush>
            </TextBlock.Foreground>
            
        </TextBlock>
            <TextBlock Background="Orange" Width="200" Height="80" FontSize="60pt" FontFamily="新宋" TextAlignment="Center" Text="Next">
                <TextBlock.Foreground>
                    <ImageBrush ImageSource="/images/03.gif" TileMode="FlipXY" ViewportUnits="Absolute" Viewport="0,0,5,5"></ImageBrush>
                </TextBlock.Foreground>

            </TextBlock>
            <TextBlock Background="Orange" Width="200" Height="80" FontSize="60pt" FontFamily="新宋" TextAlignment="Center" Text="Next">
                <TextBlock.Foreground>
                    <ImageBrush ImageSource="/images/03.gif" TileMode="FlipY" ViewportUnits="Absolute" Viewport="0,0,10,10"></ImageBrush>
                </TextBlock.Foreground>

            </TextBlock>
            <TextBlock Background="Orange" Width="200" Height="80" FontSize="60pt" FontFamily="新宋" TextAlignment="Center" Text="Next">
                <TextBlock.Foreground>
                    <ImageBrush ImageSource="/images/03.gif" TileMode="None"></ImageBrush>
                </TextBlock.Foreground>

            </TextBlock>
            <TextBlock Background="Orange" Width="200" Height="80" FontSize="60pt" FontFamily="新宋" TextAlignment="Center" Text="Next">
                <TextBlock.Foreground>
                    <ImageBrush ImageSource="/images/03.gif" TileMode="Tile" ViewportUnits="Absolute" Viewport="10,10,15,15"></ImageBrush>
                </TextBlock.Foreground>

            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
